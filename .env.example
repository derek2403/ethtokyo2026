# Keyless Relay server settings. Copy to .env.local and fill in what you need.
# Only the relay server (app/api/relay, app/api/ens) reads these; nothing here
# except NEXT_PUBLIC_* ever reaches the browser.

# --- Chain ---------------------------------------------------------------------

# Sepolia RPC for the browser app (wallet reads/writes) and, if RELAY_RPC_URL is
# unset, for the relay too. The public default is rate limited.
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Sepolia RPC the relay reads ENS from. Defaults to NEXT_PUBLIC_SEPOLIA_RPC_URL,
# then https://ethereum-sepolia-rpc.publicnode.com.
RELAY_RPC_URL=

# Optional SessionMinter (contracts/) shared by the admin app: starts an agent
# session in one transaction instead of two. The app shows this line after you
# deploy one from the Session Minter card.
NEXT_PUBLIC_SESSION_MINTER=

# --- Company -------------------------------------------------------------------

# The company root name. The relay only serves names at or under it
# (e.g. acme.eth -> eng.acme.eth -> dev.eng.acme.eth -> derek.dev.eng.acme.eth
# -> codex.derek.dev.eng.acme.eth). /api/ens/owned searches the tree under it.
# Required for relaying; without it every call is refused.
RELAY_ROOT_NAME=

# The wallet that owns RELAY_ROOT_NAME. Strongly recommended: if the root ever
# lapses and someone else registers it, the relay refuses every call instead of
# letting them spend your provider keys. Update it if you transfer the root.
RELAY_ROOT_OWNER=

# Optional DNS alias "<dns name>=<ens name>": a call as x.acme.com is checked as
# x.acme.eth (suffix replacement). Pair it with a TXT record on the DNS name:
#   "ENS1 0x6FD64A35388D2c22F1Fba96476Db59184B1fEaA0 com eth"
RELAY_DNS_ALIAS=

# Refuse names whose subname registry doesn't point back to its parent
# (UniversalHelper.findCanonicalName). Default true; set false only for testing.
RELAY_REQUIRE_CANONICAL=true

# --- Provider keys (the only place they exist) -----------------------------------
# The relay's API catalog is lib/relay/catalog.ts. Any key left empty shows as
# "no key" in the portal: the API can still be delegated, but calls to it get 503.
# Anything an allowed agent can do with a key outlives its ENS name (a deploy key
# or API token it creates stays after you remove the name), so give each key the
# least power that works. The relay also refuses the riskiest requests (see below).

# Claude (Anthropic API). Sent upstream as x-api-key. The relay only forwards
# POST /v1/messages, /v1/messages/count_tokens and GET /v1/models.
ANTHROPIC_API_KEY=
# OpenAI: used by "codex" (text) and "openai-images". Sent as Authorization: Bearer.
# codex: only POST /v1/responses, /v1/chat/completions, /v1/embeddings, GET /v1/models.
# openai-images: only POST /v1/images/generations and /v1/images/edits (each image
# counts toward relay.max.openai-images) and GET /v1/models.
OPENAI_API_KEY=
# Google Gemini. Sent as x-goog-api-key. Only generateContent,
# streamGenerateContent, countTokens (each counts as one request) and model lists.
GEMINI_API_KEY=
# GitHub: use a FINE-GRAINED PAT limited to the repos agents need, with the
# fewest permissions (e.g. Contents, Issues, Pull requests). Not a classic PAT.
# The relay refuses writes that add keys, collaborators, invitations, webhooks,
# secrets or runners, change repo or org settings, or touch .github/ (workflows).
GITHUB_TOKEN=
# Railway: use a PROJECT token (one project and environment), not an account or
# team token. The relay refuses GraphQL mutations that create tokens, invite
# people or change members, logins or integrations.
RAILWAY_TOKEN=
# The rest are forwarded (any method and path), except requests that could reveal
# secrets, create credentials, webhooks or integrations, change who has access, or
# revoke the relay's own key (e.g. Vercel tokens and env values, Stripe webhook
# endpoints, Slack auth.revoke/admin.*, HubSpot webhooks and settings, Mailchimp
# webhooks, any oauth path; Linear only gets GraphQL with issue, comment, project
# and document mutations). See routeDenial in lib/relay/routes.ts. Everything else
# passes through, so scope these keys tightly too. Each request counts as one
# toward relay.max.<api>. Sent as Authorization: Bearer unless noted.
VERCEL_TOKEN=
# Linear: sent as a raw Authorization header (a personal API key, no "Bearer").
LINEAR_API_KEY=
CANVA_TOKEN=
HUBSPOT_TOKEN=
# Mailchimp: also set RELAY_UPSTREAM_MAILCHIMP to your data center, e.g. https://us21.api.mailchimp.com
MAILCHIMP_TOKEN=
STRIPE_SECRET_KEY=
NOTION_TOKEN=
SLACK_BOT_TOKEN=
# The "mock" provider needs no key: the relay answers itself and charges $0.01 per call.

# --- Upstreams -----------------------------------------------------------------

# Override any provider's upstream base URL with RELAY_UPSTREAM_<ID>, where <ID>
# is the catalog id in upper case with "-" as "_" (e.g. to point at a local fake):
# RELAY_UPSTREAM_CLAUDE=http://127.0.0.1:8787
# RELAY_UPSTREAM_CODEX=
# RELAY_UPSTREAM_OPENAI_IMAGES=
# RELAY_UPSTREAM_GEMINI=
# RELAY_UPSTREAM_MAILCHIMP=https://us21.api.mailchimp.com
# An invalid override turns the provider off (503) rather than falling back.

# Older name for Railway's API origin (RELAY_UPSTREAM_RAILWAY wins if both are set).
RELAY_RAILWAY_URL=https://backboard.railway.com

# Extra endpoints to forward for Claude, Codex, OpenAI Images or Gemini, comma separated:
#   <provider>:<METHOD> <path>[=metered|free]   (* matches one path segment)
# "metered" (the default) is charged like the provider's other paid calls (tokens,
# images or one request); only mark an endpoint "free" if it really costs nothing.
# RELAY_EXTRA_ROUTES=codex:POST /v1/responses/compact
RELAY_EXTRA_ROUTES=

# --- Spending ------------------------------------------------------------------
# Before forwarding, the relay reserves the most a call could cost (estimated
# input + its output-token limit) and its count (1 request, or n images) against
# every capped level (relay.cap.<api> dollars, relay.max.<api> count), and
# settles when the call ends, so parallel calls can't overrun a cap. Calls that
# could cost more than the budget left are refused. Image and per-request calls
# only count when the provider answers 2xx.

# Output-token limit the relay sets on OpenAI calls that don't set one (it picks
# less when the budget left can't pay for this many).
RELAY_MAX_OUTPUT_TOKENS=32000

# Calls one name may have in flight at once.
RELAY_MAX_CONCURRENT=16

# --- Pricing -------------------------------------------------------------------

# OpenAI prices in $ per million tokens, as JSON: model -> [input, output] or
# [input, output, cached input]. Model keys match exactly or by prefix; "*" is a
# fallback. Without an entry the relay uses its built-in ESTIMATES for common
# models (gpt-5, gpt-4.1, o3, ...; see lib/relay/pricing.ts), and a PLACEHOLDER
# of [5, 20] for anything else. Neither is an official price list. Cached input
# defaults to the full input price. OpenAI Images are estimated at $0.04 per image.
# RELAY_CODEX_PRICES={"gpt-5":[1.25,10,0.125],"*":[5,20]}
RELAY_CODEX_PRICES=

# --- Access ---------------------------------------------------------------------

# Protects /api/relay/log and /api/relay/policy (names, paths, costs, spend) and
# POST /api/relay/admin/reset (clears spend of removed names; npm run demo:reset).
# Sign in at /api/relay/admin to use the admin app, or send it as
# Authorization: Bearer. Agents can always read their own names with their token.
# Without it: open to anyone in development, agents-only in production.
# Generate one with: openssl rand -hex 32
RELAY_ADMIN_TOKEN=

# Longest token lifetime (exp - iat) the relay accepts, in seconds. Default 24 h.
RELAY_MAX_TOKEN_TTL=86400

# Extra origins accepted as a token's audience (the agent CLI binds tokens to the
# relay URL it talks to). RELAY_PUBLIC_URL is always accepted.
# RELAY_AUDIENCES=https://relay.acme.com

# To revoke every token for a name without removing it, the level above sets the
# name's "relay.nbf" text record to a unix time: tokens issued earlier are refused.

# While a call runs (e.g. a long stream), the relay re-checks every this many
# seconds that each level of the caller's name is still registered and still
# owned by the token's signer. Removing a name cuts its streams off within one
# interval (SSE streams end with an "access revoked" error event). One chain read
# per name per interval, shared by all its streams. 0 turns it off.
RELAY_LIVE_CHECK_SEC=5

# --- Gas funder (POST /api/fund) ---------------------------------------------------
# A small hot wallet with Sepolia ETH that tops up new members, so they can create
# their agents without anyone sending gas by hand. Only members (a name held by
# someone else, with every level above it held by the company owner) are funded,
# once per registration, only while their balance is low. Leave the key empty to
# turn funding off. Never put a wallet with real funds here.
FUNDER_PRIVATE_KEY=
# What one top-up sends (0.02 covers login and two subagents even when gas is pricier).
FUNDER_AMOUNT_ETH=0.02
# Only wallets below this balance are topped up.
FUNDER_MIN_BALANCE_ETH=0.005
# Most the funder sends per UTC day, across everyone.
FUNDER_DAILY_LIMIT_ETH=0.5

# --- Server --------------------------------------------------------------------

# Where the spend meter and decision log are saved (relay.json). Relative to the
# app's working directory. Keep it out of git (/.data/ is ignored).
# Run ONE relay process per data directory on a writable disk: spend lives in
# that process and file, so several instances (or serverless) would each enforce
# caps on their own spend. If relay.json can't be read or saved, metered calls are
# refused until it's fixed (restore or move the file aside, then restart).
RELAY_DATA_DIR=.data

# How many proxies in front of the relay append the client's address to
# X-Forwarded-For (e.g. 1 behind one load balancer). The per-client rate limits
# use it. Leave it empty when nothing sits in front of the relay: a client can
# write that header itself, so then every caller shares one set of limits.
RELAY_TRUST_PROXY=

# Public URL of this app; /api/relay/status reports <this>/api/relay as the base
# URL tools should use (e.g. ANTHROPIC_BASE_URL=<base>/claude). Also the audience
# agent tokens must name, so set it to the URL agents use.
RELAY_PUBLIC_URL=http://localhost:3000

# --- CLI (./relay, reads these from .env.local too) ------------------------------

# Model for ./relay codex and subagent runs. Pick one your OpenAI key can use and
# that the relay can price (lib/relay/pricing.ts or RELAY_CODEX_PRICES); anything
# else is billed at the [5, 20] placeholder, which uses up small budgets fast.
# Empty = Codex's default model.
RELAY_CODEX_MODEL=
# Model for ./relay image. gpt-image-1 needs a verified OpenAI organization; use
# dall-e-3 if yours isn't.
RELAY_IMAGE_MODEL=gpt-image-1
